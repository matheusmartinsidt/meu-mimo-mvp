# Copie para .env e ajuste. Nunca versione o .env.

APP_PORT=3000
ADMIN_PORT=3001
# URL publica da loja (usada em links de pedido, e-mails e webhooks)
PUBLIC_STORE_URL=http://localhost:3000

# ---- Painel interno ----
ADMIN_EMAIL=admin@meumimo.local
ADMIN_PASSWORD=troque-essa-senha
# Segredo longo e aleatorio que assina a sessao do painel (ex: openssl rand -hex 32)
SESSION_SECRET=
# Hosts em que o painel responde (em producao: admin.seudominio.com.br)
ADMIN_HOSTS=localhost:3001,127.0.0.1:3001
ADMIN_PATH=/
# 2FA opcional: segredo base32 cadastrado no Google Authenticator / Authy
ADMIN_2FA_REQUIRED=false
ADMIN_2FA_SECRET=
# true quando houver proxy reverso (Nginx, Caddy, Cloudflare) na frente do app
TRUST_PROXY=false

# ---- Pagamento ----
# manual        -> Pix com confirmacao manual no painel (sem gateway, sem taxa)
# mercado-pago  -> Pix automatico via Mercado Pago
PAYMENT_PROVIDER=manual

# Modo manual: chave Pix que recebe os pagamentos (CPF/CNPJ, e-mail, telefone ou aleatoria)
PIX_KEY=
PIX_MERCHANT_NAME=Meu Mimo Digital
PIX_MERCHANT_CITY=Itu

# Mercado Pago (so se PAYMENT_PROVIDER=mercado-pago)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# ---- E-mail transacional (opcional, Resend) ----
RESEND_API_KEY=
EMAIL_FROM=

# ---- Banco local Docker ----
POSTGRES_DB=meu_mimo
POSTGRES_USER=meu_mimo
POSTGRES_PASSWORD=meu_mimo_dev_password
POSTGRES_PORT=5432
